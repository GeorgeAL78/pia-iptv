# Copy to .env and fill in. Keep .env private (chmod 600).

# PIA login (p1234567 style)
PIA_USERNAME=
PIA_PASSWORD=
# Region id or name, e.g. us_california, us_west, ca_vancouver, netherlands
PIA_REGION=us_california
VPN_CLIENT=wireguard

# Optional: only these LAN ranges may reach :36400 (comma-separated), e.g. 192.168.1.0/24
LAN_NETWORK=

# How browsers/TiviMate reach m3u-editor
APP_URL=http://192.168.1.15:36400

# Generate: openssl rand -hex 32  /  openssl rand -base64 24
M3U_PROXY_TOKEN=
PG_PASSWORD=

TZ=America/Los_Angeles
