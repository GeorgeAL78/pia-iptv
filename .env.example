# Copy to .env and fill in. Keep .env private (chmod 600).

# PIA login (p1234567 style)
PIA_USERNAME=
PIA_PASSWORD=
# Region id or name, e.g. us-newjersey, us_chicago, ca_toronto, uk, de-frankfurt
PIA_REGION=us-newjersey
VPN_CLIENT=wireguard

# Optional: only these LAN ranges may reach :36400 (comma-separated), e.g. 192.168.0.0/24
LAN_NETWORK=

# How browsers and players reach m3u-editor: your Docker host's LAN IP
APP_URL=http://<docker-host-ip>:36400

# m3u-editor without a web login (anyone allowed by LAN_NETWORK gets admin)
M3U_AUTO_LOGIN=false

# Optional: m3u-editor's internal secrets. Leave empty to have them generated on first start.
PG_PASSWORD=
M3U_PROXY_TOKEN=

TZ=Etc/UTC
